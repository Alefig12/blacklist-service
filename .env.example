# Plantilla del archivo .env para el ambiente de desarrollo (docker compose).
# Copie este archivo como .env y complete los valores. El .env real no se sube al repositorio.

# Llave INGEST - LICENSE de New Relic (40 caracteres, termina en NRAL).
# Sin ella la app funciona igual, pero el agente no envía datos.
NEW_RELIC_LICENSE_KEY=

# Opcional: secreto para firmar el token en local. Si se deja vacío se usa el
# secreto de desarrollo definido en docker-compose.yml.
JWT_SECRET_KEY=
